# Copy this file to ".env" and fill in your key. Never commit ".env" and never put the key in index.html.
# Create a key at https://platform.openai.com/api-keys (the image model may require organization verification).
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000

# Optional
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_INPUT_FIDELITY=high
